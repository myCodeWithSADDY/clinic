// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
}

enum Role {
  DOCTOR
  RECEPTIONIST
}

enum Service {
  CONSULTATION
  MEDICINE
}

enum AppointmentType {
  REGULAR_CHECKUP
  TELEMEDICINE
}

enum AppointmentStatus {
  CONFIRMED
  CHECKED_IN
  NO_SHOW
  CANCELLED
  COMPLETED
  RESCHEDULED
}

enum MedicineType {
  CAPSULE
  INJECTION
  DROP
  DROPS
  DROPPER
  GLOBUS
  DRAM
  TABLET
  SOLUTION
  GEL
  SYRUP
  SUSPENSION
  CREAM
  LIQUID
  LOTION
  SACHET
  OINTMENT
  POWDER
  INHALER
  SPRAY
  SUPPOSITORY
  EMULSION
  BALM
  SOAP
  SHAMPOO
  FACEWASH
  TEASPOON
  AS_PER_NEED
  HALF_HOUR_BEFORE_MEAL
  FIVE_TIMES_A_DAY
  PO // per oral
  IV // intravenous
  IM // intramuscular
  IG // intragluteal
  SC // subcutaneous
  SL // sublingual
  PR // per rectal
}

model Patient {
  id          String   @id @default(cuid())
  phone       String   @unique
  fullName    String
  gender      Gender?
  weightKg    Int?
  dateOfBirth DateTime
  cnic        String?  @unique

  houseNo String?
  area    String?
  city    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments  Appointment[]
  prescriptions Prescription[]

  @@index([fullName])
}

model User {
  id            String         @id @default(cuid())
  fullName      String
  phone         String?        @unique
  email         String         @unique
  role          Role
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  password      String
  prescriptions Prescription[]

  createdTasks   Task[] @relation("CreatedTasks")
  completedTasks Task[] @relation("CompletedTasks")
}

model Prescription {
  id String @id @default(cuid())

  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId String

  user      User     @relation(fields: [userId], references: [id])
  userId    String
  fee       Decimal? @db.Decimal(10, 2)
  diagnosis String
  disease   String
  symptoms  String
  since     DateTime

  bp     String?
  pulse  String?
  tempF  String?
  weight String?
  sugar  String?
  spo2   String?
  rr     String?

  clinicalNotes String

  medications Medication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, since])
}

model Medication {
  id String @id @default(cuid())

  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  prescriptionId String

  medicine       String
  medicineType   MedicineType
  frequency      String
  insideMedicine String?
  createdAt      DateTime     @default(now())
}

model Appointment {
  id String @id @default(cuid())

  patient      Patient? @relation(fields: [patientId], references: [id])
  patientId    String?
  fee          Decimal? @db.Decimal(10, 2)
  walkInPhone  String?
  walkInName   String?
  walkInGender Gender?
  walkInAge    String?

  service   Service
  date      DateTime
  startTime DateTime

  appointmentType AppointmentType
  complaints      String?
  notes           String?
  recurring       DateTime?

  status AppointmentStatus @default(CONFIRMED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date, startTime])
  @@index([patientId, date])
}

enum TaskType {
  PRESCRIPTION
  APPOINTMENT
}

enum TaskStatus {
  PENDING
  DONE
}

model Task {
  id            String      @id @default(cuid())

  type          TaskType
  referenceId   String

  assignedRole  Role
  status        TaskStatus  @default(PENDING)

  notes         String?

  createdById   String
  createdBy     User        @relation("CreatedTasks", fields: [createdById], references: [id])

  completedById String?
  completedBy   User?       @relation("CompletedTasks", fields: [completedById], references: [id])
  completedAt   DateTime?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([assignedRole, status])
  @@index([type, referenceId])
}